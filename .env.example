# Ma'lumotlar bazasi
# DATABASE_URL — FastAPI ilovasi uchun (async, asyncpg)
# SYNC_DATABASE_URL — Celery task'lari va Alembic uchun (sync, psycopg2)
DATABASE_URL=postgresql+asyncpg://edugroup:edugroup@db:5432/edugroup
SYNC_DATABASE_URL=postgresql+psycopg2://edugroup:edugroup@db:5432/edugroup

# JWT
SECRET_KEY=bu-kalitni-productionda-albatta-almashtiring
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie
# Local HTTP muhitda COOKIE_SECURE=false, productionda (HTTPS) — true
COOKIE_SECURE=false

# Redis — Celery broker, result backend va rate-limit storage uchun
REDIS_URL=redis://redis:6379/0

# Celery periodic task jadvali
# Enrollment so'rovi shu soatdan ko'p kutsa — expired bo'ladi
ENROLLMENT_REQUEST_EXPIRY_HOURS=72
# expire_stale_enrollments qancha vaqtda bir ishga tushadi (soniya)
ENROLLMENT_EXPIRY_CHECK_INTERVAL_SECONDS=3600
# flag_overdue_installments jadvali (crontab formati)
OVERDUE_INSTALLMENT_CHECK_CRON=0 3 * * *

# Rate limit — /auth/login va /auth/register/* uchun
AUTH_RATE_LIMIT=5/minute

# Birinchi superadmin (ilova ishga tushganda avtomatik yaratiladi)
FIRST_SUPERADMIN_EMAIL=admin@edugroup.uz
FIRST_SUPERADMIN_PASSWORD=admin12345
